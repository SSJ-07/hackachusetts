{
  "mcpServers": {
    "gtfs-mcp": {
      "command": "${SLOT_TO_STOP_HOME}/.venv/bin/python",
      "args": ["${SLOT_TO_STOP_HOME}/mcp/gtfs-mcp/server.py"],
      "env": {
        "GTFS_DIR": "${GTFS_DIR}",
        "GTFS_DATE": "${GTFS_DATE}"
      }
    },
    "reach-mcp": {
      "command": "${SLOT_TO_STOP_HOME}/.venv/bin/python",
      "args": ["${SLOT_TO_STOP_HOME}/mcp/reach-mcp/server.py"],
      "env": {}
    }
  }
}
