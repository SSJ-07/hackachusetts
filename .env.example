# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# mcp.json references these by name (e.g. ${CENSUS_API_KEY}), never the literal value.

# Census API (ACS downloads) — https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=

# GitHub token for the GitHub MCP server / gh CLI
GITHUB_TOKEN=

# Kiro CLI (headless CI auth)
KIRO_API_KEY=
